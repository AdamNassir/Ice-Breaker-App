# Leave blank for local SQLite. REQUIRED on Vercel.
# Copy Supabase's Transaction pooler URI; change username to icebreaker_app.PROJECT_REF.
DATABASE_URL=postgresql://icebreaker_app.zzcjpiunekmpqbkxesmr:password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# REQUIRED on Vercel; choose a long random password. Never put this in static files.
PRESENTER_PASSWORD=azerty
# Optional: exact public URL (also useful with local LAN access).
PUBLIC_BASE_URL=
# Local-only persistence (ignored when DATABASE_URL is set).
SQLITE_PATH=game.sqlite3

# New: protect global /deck-manager and shared deck API. Required for online editing.
# Choose a LONG UNIQUE password and configure the exact same value in Mercato Organizer.
DECK_ADMIN_PASSWORD=
# Connect a PUBLIC Vercel Blob store to the IceBreaker Vercel project.
BLOB_READ_WRITE_TOKEN=
